# Frontend (safe to expose — anon key is read-only thanks to RLS policy in schema.sql)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Scrapers only (server-side / GitHub Actions secrets — NEVER commit real values, NEVER
# put this in the frontend .env or expose it in any client-side code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
